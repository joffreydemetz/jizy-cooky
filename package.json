{
  "name": "jizy-cooky",
  "version": "2.0.0",
  "browser": "dist/js/jizy-cooky.min.js",
  "main": "lib/index.js",
  "type": "module",
  "files": [
    "dist/js/jizy-cooky.min.js",
    "dist/css/jizy-cooky.min.css",
    "dist/fonts/*",
    "dist/images/*",
    "lib/js/*.js",
    "lib/less/*.less",
    "lib/index.js",
    "lib/cooky.less"
  ],
  "scripts": {
    "jpack:export": "node ./cli/jpack.js --action build --name perso",
    "jpack:export-debug": "node ./cli/jpack.js --action build --name perso --debug",
    "jpack:dist": "node ./cli/jpack.js",
    "jpack:dist-debug": "node ./cli/jpack.js --debug"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joffreydemetz/jizy-cooky.git"
  },
  "keywords": [
    "cooky",
    "gdpr",
    "compliance"
  ],
  "author": "Joffrey Demetz <joffrey.demetz@gmail.com> (https://joffreydemetz.com/)",
  "license": "MIT",
  "description": "A lightweight and modular GDPR management library",
  "devDependencies": {
    "jizy-packer": "^2.1.0"
  }
}